# Application Settings
PROJECT_NAME="L'Étoile Artisan Bakery API"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Security
SECRET_KEY=bakery_super_secret_development_key_change_in_production_32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# PostgreSQL Database (Fallback to SQLite in local dev)
DATABASE_URL=sqlite+aiosqlite:///./bakery.db
DATABASE_SYNC_URL=sqlite:///./bakery.db

# Google Auth
GOOGLE_CLIENT_ID=paste_your_actual_google_client_id_here
