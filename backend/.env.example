# Application Settings
PROJECT_NAME="L'Étoile Artisan Bakery API"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Security
SECRET_KEY=bakery_super_secret_development_key_change_in_production_32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bakery_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/bakery_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Razorpay
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Bakery Defaults
DEFAULT_MIN_PREP_HOURS_STANDARD=3
DEFAULT_MIN_PREP_HOURS_CUSTOM=24
SAME_DAY_CUTOFF_HOUR=18
DEFAULT_CURRENCY=INR
DEFAULT_TAX_RATE_PERCENT=5.0
FREE_DELIVERY_THRESHOLD=999.0
STANDARD_DELIVERY_FEE=99.0
